# Copier ce fichier en .env.local pour le développement local.
# Ces deux valeurs sont PUBLIQUES par conception (protégées par les règles RLS) :
# elles figurent dans Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# NE JAMAIS mettre ici de clé secrète (service_role, TomTom, openrouteservice...).
# Les clés privées se configurent uniquement en secrets Supabase :
#   supabase secrets set TOMTOM_API_KEY=...      # trafic en direct (optionnel)
#   supabase secrets set ORS_API_KEY=...         # itinéraires openrouteservice (optionnel)
#   supabase secrets set ALLOWED_ORIGINS=https://milyasse.github.io,http://localhost:5173

# Utilisé uniquement par scripts/realtime-check.mjs et scripts/smoke-check.mjs
APP_URL=https://milyasse.github.io/trafic-rsk/
