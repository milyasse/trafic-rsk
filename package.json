{
  "name": "trafic-rsk",
  "private": true,
  "version": "1.0.0",
  "description": "Navigation et trafic communautaire pour la région Rabat-Salé-Kénitra",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:realtime": "node scripts/realtime-check.mjs",
    "test:smoke": "node scripts/smoke-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "maplibre-gl": "^5.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.6",
    "vitest": "^3.2.4"
  }
}
